{
  "manifest_version": 3,
  "name": "Slack 8x8 Autofill",
  "version": "1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.slack.com/*",
    "https://backoffice.gopuff.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Slack 8x8 Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["Gopufflogo.png"],
      "matches": ["https://*.slack.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://backoffice.gopuff.com/*"],
      "js": ["content-company.js"]
    },
    {
      "matches": ["https://*.slack.com/*"],
      "js": ["content-slack.js"]
    }
  ]
}
